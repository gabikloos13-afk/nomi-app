{
  "id": "./",
  "name": "Nomi – Reiseplanung",
  "short_name": "Nomi",
  "description": "Reisen, Aufgaben, Packlisten, Informationen und Dokumente übersichtlich organisieren.",
  "lang": "de-DE",
  "dir": "ltr",
  "start_url": "./",
