  "categories": [
    "travel",
    "productivity"
  ],
  "icons": [
    {
      "src": "./icons/nomi-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/nomi-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/nomi-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/nomi-mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
